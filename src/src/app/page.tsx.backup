                    <div className={`w-12 h-12 rounded-xl ${colors[index % colors.length]} flex items-center justify-center mx-auto mb-3`}>
                      <IconComp className="h-6 w-6" />
                    </div>
                    <h3 className="font-bold text-gray-800 mb-2">{valor.nombre}</h3>
