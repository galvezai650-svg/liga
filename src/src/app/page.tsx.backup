                  <Goal className="h-10 w-10 text-green-600 mx-auto mb-4" />
                  <h3 className="font-bold text-gray-800 mb-2">Asamblea General</h3>
                  <p className="text-gray-600 text-sm">Máximo órgano de gobierno</p>
