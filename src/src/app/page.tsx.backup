    subitems: [
      { label: "Partidos", section: "programacion" as Section },
      { label: "Estadísticas", section: "estadisticas" as Section },
      { label: "Resoluciones", section: "resoluciones" as Section },
    ],
  },
  { label: "Noticias", section: "noticias" as Section },
  { label: "Eventos", section: "eventos" as Section },
  {
    label: "Nosotros",
    section: "nosotros" as Section,
    subitems: [
      { label: "Organización", section: "organizacion" as Section },
      { label: "Documentos", section: "documentos" as Section },
      { label: "Clubes", section: "clubes" as Section },
    ],
  },
];

